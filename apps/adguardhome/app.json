{
  "schema": 3,
  "id": "adguardhome",
  "name": "AdGuard Home",
  "version": "1.0.0",
  "category": "Network",
  "summary": "DNS queries, blocked queries and protection status from your AdGuard Home server.",
  "description": "Reads AdGuard Home's API on your network (http://<address>/control/status and /control/stats), signing in with your AdGuard Home username and password. The counts cover AdGuard Home's statistics period (24 hours unless you changed it under Settings → General settings → Statistics).",
  "author": "MeshHome",
  "homepage": "https://github.com/roach0816/MeshHome-apps/tree/main/apps/adguardhome",
  "min_meshhome": "1.0.1",
  "settings": [
    {
      "key": "host",
      "label": "AdGuard Home address",
      "type": "host",
      "required": true,
      "placeholder": "192.168.1.53:3000",
      "help": "The IP address or hostname of AdGuard Home's web interface on your network, with its port if it isn't 80. It is read over http://."
    },
    {
      "key": "username",
      "label": "Username",
      "type": "text",
      "required": true,
      "help": "The username you sign in to AdGuard Home's web interface with."
    },
    {
      "key": "password",
      "label": "Password",
      "type": "secret",
      "required": true
    }
  ],
  "sources": {
    "status": {
      "url": "http://{host}/control/status",
      "network": "local",
      "auth": {"basic": {"username": "{username}", "password": "{password}"}},
      "timeout": 6,
      "cache_seconds": 60
    },
    "stats": {
      "url": "http://{host}/control/stats",
      "network": "local",
      "auth": {"basic": {"username": "{username}", "password": "{password}"}},
      "timeout": 6,
      "cache_seconds": 60
    }
  },
  "commands": [
    {
      "name": "dns",
      "help": "DNS blocking stats",
      "sources": ["stats", "status"],
      "values": {
        "queries": {"from": ["num_dns_queries"]},
        "blocked": {"from": ["num_blocked_filtering"]},
        "safe": {"from": ["num_replaced_safebrowsing"]},
        "protection": {
          "source": "status",
          "from": ["protection_enabled"],
          "format": "text",
          "map": {"true": "protection on", "false": "protection OFF"}
        }
      },
      "reply": {
        "parts": [
          {"items": ["{queries} queries", "{blocked} blocked"]},
          {"items": ["{protection}"]},
          {"items": ["{safe} malware/phishing"], "drop": "end"}
        ],
        "join": " · ",
        "item_join": " · ",
        "max_bytes": 150,
        "empty": "AdGuard Home reported no statistics.",
        "unavailable": "AdGuard Home isn't answering right now."
      }
    }
  ]
}
