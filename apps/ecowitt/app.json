{
  "schema": 3,
  "id": "ecowitt",
  "name": "Ecowitt weather station",
  "version": "1.1.0",
  "category": "Weather",
  "summary": "Local weather from your Ecowitt gateway or Wi-Fi console: temperature, humidity, wind, rain and air quality, and tomorrow's forecast.",
  "description": "Reads the gateway's local live data (http://<gateway>/get_livedata_info) on your network. No Ecowitt account or cloud connection is used. Works with gateways and consoles such as the GW1100, GW2000 and GW3000, and their sensors (WS90, WH41/WH43 PM2.5, WH45/WH46 air quality). Readings use the units set on the gateway. Enter your latitude and longitude to add tomorrow's forecast (conditions, high and low, and wind) from Open-Meteo (api.open-meteo.com), which needs no account; your station's readings are still sent when the forecast can't be read.",
  "author": "MeshHome",
  "homepage": "https://github.com/roach0816/MeshHome-apps/tree/main/apps/ecowitt",
  "min_meshhome": "1.0.2",
  "hosts": ["api.open-meteo.com"],
  "settings": [
    {
      "key": "host",
      "label": "Gateway address",
      "type": "host",
      "required": true,
      "placeholder": "192.168.1.50",
      "help": "The IP address or hostname of your Ecowitt gateway or Wi-Fi console on your network (optionally :port)."
    },
    {
      "key": "latitude",
      "label": "Latitude (for the forecast)",
      "type": "text",
      "required": false,
      "placeholder": "40.71",
      "help": "Optional. Your location in decimal degrees, for tomorrow's forecast from Open-Meteo. Two decimals (about 1 km) is plenty. Leave blank for no forecast."
    },
    {
      "key": "longitude",
      "label": "Longitude (for the forecast)",
      "type": "text",
      "required": false,
      "placeholder": "-74.01",
      "help": "Optional. Negative west of Greenwich, such as -74.01 for New York."
    },
    {
      "key": "temp_unit",
      "label": "Forecast temperature unit",
      "type": "select",
      "default": "fahrenheit",
      "options": [
        {"value": "fahrenheit", "label": "°F"},
        {"value": "celsius", "label": "°C"}
      ],
      "help": "Choose the unit your gateway uses, so the forecast matches its readings."
    },
    {
      "key": "wind_unit",
      "label": "Forecast wind unit",
      "type": "select",
      "default": "mph",
      "options": [
        {"value": "mph", "label": "mph"},
        {"value": "kmh", "label": "km/h"},
        {"value": "ms", "label": "m/s"},
        {"value": "kn", "label": "knots"}
      ]
    }
  ],
  "sources": {
    "live": {
      "url": "http://{host}/get_livedata_info",
      "network": "local",
      "timeout": 6,
      "cache_seconds": 60
    },
    "forecast": {
      "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&daily=weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max&temperature_unit={temp_unit}&wind_speed_unit={wind_unit}&timezone=auto&forecast_days=2",
      "network": "internet",
      "timeout": 6,
      "cache_seconds": 1800
    }
  },
  "commands": [
    {
      "name": "weather",
      "help": "local weather",
      "sources": ["live", "forecast"],
      "values": {
        "temp": {
          "from": ["common_list[id=0x02].val"],
          "unit_from": ["common_list[id=0x02].unit"],
          "unit_map": {"F": "°F", "C": "°C"}
        },
        "humidity": {"from": ["common_list[id=0x07].val"]},
        "wind": {"from": ["common_list[id=0x0B].val"]},
        "gust": {"from": ["common_list[id=0x0C].val"]},
        "wind_dir": {"from": ["common_list[id=0x0A].val"], "format": "compass"},
        "rain": {
          "from": [
            {"path": "piezoRain[id=0x7C].val", "label": "24h"},
            {"path": "piezoRain[id=0x10].val", "label": "today"},
            {"path": "rain[id=0x7C].val", "label": "24h"},
            {"path": "rain[id=0x10].val", "label": "today"}
          ]
        },
        "aqi": {"from": ["ch_pm25[0].PM25_RealAQI", "co2[0].PM25_RealAQI"]},
        "pm25": {"from": ["ch_pm25[0].PM25", "co2[0].PM25"]},
        "pm10": {"from": ["co2[0].PM10"]},
        "co2": {"from": ["co2[0].CO2"]},
        "tmrw_sky": {
          "source": "forecast",
          "from": ["daily.weather_code[1]"],
          "format": "text",
          "map": {
            "0": "☀️", "1": "🌤️", "2": "⛅", "3": "☁️", "45": "🌫️", "48": "🌫️",
            "51": "🌦️", "53": "🌦️", "55": "🌦️", "56": "🌨️", "57": "🌨️",
            "61": "🌧️", "63": "🌧️", "65": "🌧️", "66": "🌨️", "67": "🌨️",
            "71": "❄️", "73": "❄️", "75": "❄️", "77": "❄️",
            "80": "🌦️", "81": "🌧️", "82": "🌧️", "85": "🌨️", "86": "🌨️",
            "95": "⛈️", "96": "⛈️", "99": "⛈️"
          }
        },
        "tmrw_high": {"source": "forecast", "from": ["daily.temperature_2m_max[1]"]},
        "tmrw_low": {
          "source": "forecast",
          "from": ["daily.temperature_2m_min[1]"],
          "unit_from": ["daily_units.temperature_2m_min"]
        },
        "tmrw_wind": {
          "source": "forecast",
          "from": ["daily.wind_speed_10m_max[1]"],
          "unit_from": ["daily_units.wind_speed_10m_max"],
          "unit_map": {"mp/h": "mph"}
        }
      },
      "reply": {
        "parts": [
          {"items": ["🌡️{temp}{temp.unit}", "💧{humidity}%"]},
          {"items": ["💨{wind} {wind.unit}[ {wind_dir}][, gust {gust}]"]},
          {"items": ["☔{rain} {rain.unit} {rain.label}"]},
          {"items": ["Tmrw[ {tmrw_sky}] {tmrw_high}/{tmrw_low}{tmrw_low.unit}[ 💨{tmrw_wind} {tmrw_wind.unit}]"]},
          {"items": ["🍃AQI {aqi}", "🌫️PM2.5 {pm25}", "PM10 {pm10}", "🫁CO2 {co2}ppm"], "drop": "end"}
        ],
        "join": " · ",
        "item_join": " ",
        "max_bytes": 150,
        "empty": "The weather station reported no outdoor readings.",
        "unavailable": "The weather station is not answering right now."
      }
    }
  ]
}
