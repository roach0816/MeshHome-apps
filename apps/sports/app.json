  "sources": {
    "team": {
      "url": "https://site.api.espn.com/apis/site/v2/sports/{league}/teams/{team}",
      "network": "internet",
      "timeout": 8,
      "cache_seconds": 120
    },
    "schedule": {
      "url": "https://site.api.espn.com/apis/site/v2/sports/{league}/teams/{team}/schedule",
      "network": "internet",
      "timeout": 10,
      "cache_seconds": 600,
      "max_kb": 2048
    }
  },
  "commands": [
    {
      "name": "sports",
      "help": "your team's last and next game",
      "sources": [
        "schedule",
        "team"
      ],
      "values": {
        "l_away": {
          "from": [
            "events[last:competitions.0.status.type.completed=true].competitions[0].competitors[homeAway=away].team.abbreviation"
          ],
          "format": "text"
        },
        "l_away_score": {
          "from": [
            "events[last:competitions.0.status.type.completed=true].competitions[0].competitors[homeAway=away].score.displayValue"
          ],
          "format": "text"
        },
        "l_home": {
          "from": [
            "events[last:competitions.0.status.type.completed=true].competitions[0].competitors[homeAway=home].team.abbreviation"
          ],
          "format": "text"
        },
        "l_home_score": {
          "from": [
            "events[last:competitions.0.status.type.completed=true].competitions[0].competitors[homeAway=home].score.displayValue"
          ],
          "format": "text"
        },
        "l_status": {
          "from": [
            "events[last:competitions.0.status.type.completed=true].competitions[0].status.type.shortDetail"
          ],
          "format": "text"
        },
        "n_state": {
          "source": "team",
          "from": [
            "team.nextEvent[0].competitions[0].status.type.state"
          ],
          "format": "text",
          "map": {
            "pre": "Next",
            "in": "Now",
            "post": ""
          }
        },
        "n_away": {
          "source": "team",
          "from": [
            "team.nextEvent[0].competitions[0].competitors[homeAway=away].team.abbreviation"
          ],
          "format": "text"
        },
        "n_away_score": {
          "source": "team",
          "from": [
            "team.nextEvent[0].competitions[0].competitors[homeAway=away].score.displayValue",
            "team.nextEvent[0].competitions[0].competitors[homeAway=away].score"
          ],
          "format": "text"
        },
        "n_home": {
          "source": "team",
          "from": [
            "team.nextEvent[0].competitions[0].competitors[homeAway=home].team.abbreviation"
          ],
          "format": "text"
        },
        "n_home_score": {
          "source": "team",
          "from": [
            "team.nextEvent[0].competitions[0].competitors[homeAway=home].score.displayValue",
            "team.nextEvent[0].competitions[0].competitors[homeAway=home].score"
          ],
          "format": "text"
        },
        "n_status": {
          "source": "team",
          "from": [
            "team.nextEvent[0].competitions[0].status.type.shortDetail"
          ],
          "format": "text"
        },
        "record": {
          "source": "team",
          "from": [
            "team.record.items[0].summary"
          ],
          "format": "text"
        }
      },
      "reply": {
        "parts": [
          {
            "items": [
              "Last: {l_away} {l_away_score} @ {l_home} {l_home_score} {l_status}"
            ]
          },
          {
            "items": [
              "{n_state}: {n_away}[ {n_away_score}] @ {n_home}[ {n_home_score}] {n_status}"
            ]
          },
          {
            "items": [
              "{record}"
            ],
            "drop": "end"
          }
        ],
        "join": " · ",
        "max_bytes": 150,
        "empty": "ESPN has no recent or upcoming games for this team.",
        "unavailable": "ESPN isn't answering right now."
      }
    }
  ]
}
